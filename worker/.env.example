# Copy to .env: cp .env.example .env
# NEVER commit .env — it holds secrets.

# Contract ID of StellarFeed (output of `stellar contract deploy`)
STELLAR_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAXXXX
# `stellar keys` identity that pays fees (holds NO price authority)
STELLAR_SOURCE_ACCOUNT=alice
# testnet | mainnet
STELLAR_NETWORK=testnet

# Pyth Pro API key (required). Get one at:
# https://docs.pyth.network/price-feeds/pro/subscribe-to-prices
PYTH_API_KEY=replace-me
# Websocket endpoint (use ...-1 / ...-2 on a second worker for redundancy)
PYTH_WS_URL=wss://pyth-lazer-0.dourolabs.app/v1/stream
# Feed IDs to subscribe (BTC/USD=1, ETH/USD=2 — full list at
# https://docs.pyth.network/price-feeds/pro/price-feed-ids)
PYTH_FEED_IDS=1,2
# Lazer channel: fixed_rate@1000ms is plenty for an on-chain relay
PYTH_CHANNEL=fixed_rate@1000ms
# Seconds between on-chain relays (chain writes cost fees — don't stream ticks)
RELAY_INTERVAL_SECS=60
# DRY_RUN=1 → receive and log only, never send transactions
DRY_RUN=0
