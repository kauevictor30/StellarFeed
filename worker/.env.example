# Copy to .env: cp .env.example .env

# StellarFeed contract ID (output of `stellar contract deploy`)
STELLAR_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAXXXX
# `stellar keys` identity that is the contract Admin
STELLAR_SOURCE_ACCOUNT=alice
# testnet | mainnet | futurenet
STELLAR_NETWORK=testnet
# Allows pointing to a mock in tests
COINGECKO_URL=https://api.coingecko.com/api/v3
# Interval between cycles (seconds). CoinGecko free tier: >= 300 recommended
POLL_INTERVAL_SECS=300
# Must match the contract's PRICE_SCALE (1e7)
PRICE_SCALE=10000000
# DRY_RUN=1 → only fetch and log, never send transactions
DRY_RUN=0
