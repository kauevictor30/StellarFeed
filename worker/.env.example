# Copie para .env: cp .env.example .env

# Contract ID do StellarFeed (saída do `stellar contract deploy`)
STELLAR_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAXXXX
# Identidade do `stellar keys` que é Admin do contrato
STELLAR_SOURCE_ACCOUNT=alice
# testnet | mainnet | futurenet
STELLAR_NETWORK=testnet
# Permite apontar para mock em testes
COINGECKO_URL=https://api.coingecko.com/api/v3
# Intervalo entre ciclos (segundos). CoinGecko free: >= 300 recomendado
POLL_INTERVAL_SECS=300
# Deve bater com PRICE_SCALE do contrato (1e7)
PRICE_SCALE=10000000
# DRY_RUN=1 → só coleta e loga, não envia transação
DRY_RUN=0
